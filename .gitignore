# Dependencies
node_modules/

# Build output
dist/
.vite/

# Local / editor / tooling
*.local
.claude/
.vscode/
.idea/

# Environment
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Generated rules documents: built on demand from the HTMLs by docs/build-pdf.py
# and kept on the Drive, so a local rebuild never re-enters the repo.
docs/rules-list.pdf
docs/rules-reference.pdf

# Cowork bridge: the one machine-local line, split out of CONTEXT.md so the
# orientation file itself can travel. The rest of _cowork/ is committed on
# purpose — see .claude/bridge/PROTOCOL.md
_cowork/CONTEXT.local.md

# Cowork bridge: keep the protocol and skills tracked, ignore the rest of .claude/
!.claude/
.claude/*
!.claude/bridge/
!.claude/skills/
